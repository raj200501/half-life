    "023b437a79d9fe419cd9b81299ed9133bddd7c82660eadaecf2fc5512f7e6e7b": "\"\"\"Small invoicing helpers.\"\"\"\n\nfrom invoice.core import Invoice, LineItem, parse_date\n\n__all__ = [\"Invoice\", \"LineItem\", \"parse_date\"]\n",
    "0847fc1373f547832c85ef7d068f03f3726b88bc92ce0cf530d0b28d8404f5a8": "\"\"\"Core invoice model.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom datetime import datetime\n\n\n@dataclass\nclass LineItem:\n    \"\"\"One billed line: a description, a unit price in cents, and a quantity.\"\"\"\n\n    description: str\n    unit_cents: int\n    quantity: int = 1\n\n    def total_cents(self) -> int:\n        \"\"\"Price of the line before discounts.\"\"\"\n        return self.unit_cents * self.quantity\n\n\n@dataclass\nclass Invoice:\n    \"\"\"An invoice with line items and an optional percentage discount.\"\"\"\n\n    number: str\n    items: list[LineItem] = field(default_factory=list)\n    discount_percent: int = 0\n\n    def subtotal_cents(self) -> int:\n        \"\"\"Sum of line totals before the discount.\"\"\"\n        return sum(item.total_cents() for item in self.items)\n\n    def total_cents(self) -> int:\n        \"\"\"Total after the discount, rounded down to whole cents.\"\"\"\n        subtotal = self.subtotal_cents()\n        return subtotal - subtotal * self.discount_percent // 100\n\n\ndef parse_date(text: str) -> datetime:\n    \"\"\"Parse an invoice date written as YYYY-MM-DD.\"\"\"\n    return datetime.fromisoformat(text)\n",
    "1def0406dfb8aade713bead4fb273520da2e67426313a9fa2c32611fa46cba00": "# Changelog\n\n## Unreleased\n",
    "41b6d3f41e06c0149567fde92ae862bbf25ebb0929c82dfbc5f6ef78c8f123a7": "# Changelog\n\n## Unreleased\n\n- Clarify the format_cents docstring.\n\n- parse_date accepts ISO-8601 timestamps with offsets.\n\n- Fix discount calculation to use percent.\n\n- Add tax_cents helper.\n",
    "445238120eced9be79dec57dcb3cc38465cf724e25b8be0f23f0abc0ab31f5a8": "# Changelog\n\n## Unreleased\n\n- Fix discount calculation to use percent.\n\n- Add tax_cents helper.\n",
    "4b5d89c7147ca22849ab8b7d4f7c1e21ce7dfbb6c083f6ed8fed14b0c6cff43c": "\"\"\"Core invoice model.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass, field\nfrom datetime import datetime\n\n\n@dataclass\nclass LineItem:\n    \"\"\"One billed line: a description, a unit price in cents, and a quantity.\"\"\"\n\n    description: str\n    unit_cents: int\n    quantity: int = 1\n\n    def total_cents(self) -> int:\n        \"\"\"Price of the line before discounts.\"\"\"\n        return self.unit_cents * self.quantity\n\n\n@dataclass\nclass Invoice:\n    \"\"\"An invoice with line items and an optional percentage discount.\"\"\"\n\n    number: str\n    items: list[LineItem] = field(default_factory=list)\n    discount_percent: int = 0\n\n    def subtotal_cents(self) -> int:\n        \"\"\"Sum of line totals before the discount.\"\"\"\n        return sum(item.total_cents() for item in self.items)\n\n    def total_cents(self) -> int:\n        \"\"\"Total after the discount, rounded down to whole cents.\"\"\"\n        subtotal = self.subtotal_cents()\n        return subtotal - subtotal * self.discount_percent // 100\n\n\ndef parse_date(text: str) -> datetime:\n    \"\"\"Parse an invoice date written as YYYY-MM-DD.\"\"\"\n    return datetime.strptime(text, \"%Y-%m-%d\")\n",
    "610c90848b16d985d2f7da3a51f4f241a9ad10cbf12abb100899d2432ad2f7bc": "from invoice.core import Invoice, LineItem, parse_date\n\n\ndef test_line_total():\n    assert LineItem(\"pen\", 150, 4).total_cents() == 600\n\n\ndef test_subtotal():\n    inv = Invoice(\"A-1\", [LineItem(\"pen\", 150, 2), LineItem(\"pad\", 400)])\n    assert inv.subtotal_cents() == 700\n\n\ndef test_total_with_discount():\n    inv = Invoice(\"A-2\", [LineItem(\"desk\", 10000)], discount_percent=15)\n    assert inv.total_cents() == 8500\n\n\ndef test_parse_date():\n    assert parse_date(\"2024-02-29\").day == 29\n",
    "72161b8476a11a1c05ecd437df7914bc08dbdfea2e71707adf4fdea4ca9f05b6": "# invoice\n\nInvoicing helpers. Run the tests with `python -m pytest -q`.\n",
    "7c4386830a3b23bccf2caac8573ed0feebd9b33acba5e16d7822776ee7f92a01": "# Changelog\n\n## Unreleased\n\n- parse_date accepts ISO-8601 timestamps with offsets.\n\n- Fix discount calculation to use percent.\n\n- Add tax_cents helper.\n",
    "90876fa4dd36f09cd7a96077b8de5dca54e700873b9c199bed4d9f155d66ae00": "from invoice.format import format_cents\n\n\ndef test_format_cents():\n    assert format_cents(1234) == \"$12.34\"\n    assert format_cents(5) == \"$0.05\"\n",
    "91eab475d934d888c7102209a741d9ae16ea46775a8cfa38635f97741961cf5c": "# Runtime dependencies (none beyond the standard library).\n",
    "96ea7f93e67ee2066f2c5e3ee9e6e1d2080a112c31e43c8a4485120227f295da": "\"\"\"Formatting helpers for invoices.\"\"\"\n\n\ndef format_cents(cents: int) -> str:\n    \"\"\"Format an amount in cents as dollars, for example, 1234 becomes '$12.34'.\"\"\"\n    return f\"${cents // 100}.{cents % 100:02d}\"\n\n\ndef tax_cents(amount_cents: int, rate_percent: int) -> int:\n    \"\"\"Tax on an amount, rounded down to whole cents.\"\"\"\n    return amount_cents * rate_percent // 100\n",
    "afa7e1bee29acfce5a8942d78b2e4e1bace591364bf2870918c88927f9854116": "\"\"\"Formatting helpers for invoices.\"\"\"\n\n\ndef format_cents(cents: int) -> str:\n    \"\"\"Format an amount in cents as dollars, for example 1234 -> '$12.34'.\"\"\"\n    return f\"${cents // 100}.{cents % 100:02d}\"\n\n\ndef tax_cents(amount_cents: int, rate_percent: int) -> int:\n    \"\"\"Tax on an amount, rounded down to whole cents.\"\"\"\n    return amount_cents * rate_percent // 100\n",
